# Copy this file to .env (same folder) and fill in real values. .env is git-ignored:
# it never leaves your computer. On Render, the same names go under Environment.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neon → your Safari Ember project → Connection string, for a database called ember_dev.
# It looks like: postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/ember_dev?sslmode=require
DATABASE_URL=

# A SECOND database that the tests wipe and rebuild on every run (ember_test). Never real data.
TEST_DATABASE_URL=

# Where the site runs locally (python server.py in the project folder serves port 8000).
SITE_URL=http://localhost:8000

# Signs guests' booking links. Generate one per environment (laptop and Render get DIFFERENT values):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared with Netlify's signed proxy (Phase 6). Leave empty on your laptop.
NETLIFY_PROXY_SECRET=

# Booking rules (docs/BLUEPRINT.md). These are the defaults; uncomment to change.
# DEPOSIT_PERCENT=30
# HOLD_MINUTES=15
# MAX_NIGHTS=30
# BOOKING_HORIZON_MONTHS=18
# FEW_LEFT=3

# ── Deposits (Phase 3) ──────────────────────────────────────────────────────────────────
# Each method is offered only when ALL its values are set; leave them empty to switch it off.
#
# M-Pesa: Safaricom Daraja (developer.safaricom.co.ke → My Apps). Sandbox: shortcode 174379 and
# the sandbox passkey from Daraja's test credentials page. The NURA sandbox app's keys work here.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Where Safaricom can reach this API from the internet (it can't reach localhost: on your laptop,
# payments settle when the booking page asks Safaricom instead, so this can be any https address).
PUBLIC_API_URL=
# A secret part of the callback address, so only Safaricom (who's told it) can post there:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# In the sandbox every prompt asks for this many shillings, not the real deposit.
# DARAJA_SANDBOX_AMOUNT_KES=1

# Cards: Paystack (dashboard.paystack.com → Settings → API Keys & Webhooks). Use the TEST secret
# key (sk_test_…) until launch. Webhook URL to set there: <PUBLIC_API_URL>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Extra minutes a hold gets when the guest starts paying, so a PIN typed at 14:59 still counts.
# PAYMENT_GRACE_MINUTES=5
